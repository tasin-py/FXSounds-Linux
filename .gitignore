# build output
/build/
/build-*/
/dist/
*.o
*.a

# local test VM (disk images, ISO, SSH key, password) - never publish
/vm/

# copies of the installed Windows app and the local Windows user data (reference only, not ours to publish)
/reference/windows-fxsound-*/
/reference/windows-user-data/

# test recordings and screenshots (regenerated by the tests); keep the reference render
/test/out/*
!/test/out/ref_general_gui.wav
/test/out-win/
/test/screens/

# upstream source fonts: the build uses JuceLibraryCode/BinaryData and Fonts-runtime
/upstream/fxsound/Fonts/

__pycache__/
*.pyc
.vs/
.vscode/
.claude/
